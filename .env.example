# ═══════════════════════════════════════════════════════════════
# Variables de entorno de la API — PLANTILLA
# Copie este archivo como .env y ajuste los valores.
# El archivo .env está en .gitignore: NUNCA se sube al repositorio.
# En producción (Render) estas variables se definen en su panel.
# ═══════════════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────────────
# Render define PORT automáticamente. En local se usa 8080.
PORT=8080

# ── Base de datos PostgreSQL ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oye_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── Seguridad JWT ─────────────────────────────────────────────
# En producción: al menos 32 bytes aleatorios codificados en Base64.
JWT_SECRET=reemplazar_por_un_secreto_en_base64
JWT_EXPIRATION_SECONDS=900

# ── Proveedor de correo ───────────────────────────────────────
# smtp  → JavaMail (no funciona en Render: bloquea los puertos SMTP)
# brevo → API HTTPS de Brevo (recomendado en producción)
EMAIL_PROVIDER=brevo

# ── Brevo (si EMAIL_PROVIDER=brevo) ───────────────────────────
# La API key se genera en Brevo: Configuración → SMTP y API → Claves API.
# El remitente debe estar verificado en Brevo: Configuración → Remitentes.
BREVO_API_KEY=reemplazar_por_la_api_key_de_brevo
BREVO_SENDER_EMAIL=tu_correo_verificado@dominio.com
BREVO_SENDER_NAME=Oye! - Organiza tus gastos

# ── SMTP (solo si EMAIL_PROVIDER=smtp) ────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_aqui
SMTP_FROM_ADDRESS=tu_correo@gmail.com
SMTP_FROM_NAME=Gestion de Usuarios